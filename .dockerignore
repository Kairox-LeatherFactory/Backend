# Python caches / local virtualenv (the image installs its own deps)
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Secrets — provided at runtime via env_file / environment, never baked in.
# Broad glob so .env.bak / .env.local / .env.prod never leak into a layer.
.env
.env.*
*.bak

# VCS / tooling — not needed inside the image
.git/
.github/
.claude/
.gitattributes
.gitignore
.importlinter

# Docs (Markdown) + scratch notes — not used at runtime
*.md
_specs/
Issues & risks.txt
file_structure.txt

# Dev artifacts / large dumps that bloat the build context
full_project_dump.txt
app/all_code.txt
*_dump.txt
openapi.json
*.log

# Runtime-generated local storage (uploaded/quarantined docs). The container
# recreates LOCAL_STORAGE_DIR on demand — never bake host uploads into the image.
var/

# NOTE: keep app/, alembic/, scripts/, config/, data/, tests/, requirements.txt,
# entrypoint.sh, alembic.ini — all required for migrate + seed + run + pytest.
