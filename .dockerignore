var/procurement-documents/
# Keep secrets, git history, caches, and the big sample spreadsheets OUT of the image.
.git
.gitignore
.env
.env.*
!.env.*.example
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.venv/
venv/
node_modules/

# Big Excel/PDF sample files are not needed at runtime — exclude them.
*.xlsx
*.xls
*.pdf

# NOTE: we do NOT exclude *.csv, because the seed loader needs
# data/clean_leather_lots_finalZZ.csv inside the image. If you have other large
# throwaway CSVs, exclude them individually instead of a blanket *.csv rule, e.g.:
# some_big_export.csv