# The image needs: app/, alembic/, alembic.ini, config/, scripts/, entrypoint.sh,
# requirements.txt. Everything else stays OUT — secrets, client data, tests, docs.

# Secrets
.env
.env.*
!.env.*.example
aws.txt

# VCS / editor / tooling
.git
.gitignore
.gitattributes
.github/
.vscode/
.claude/
.importlinter
.coveragerc
.coverage
htmlcov/
.pytest_cache/
.mypy_cache/
__pycache__/
*.pyc
.venv/
venv/
node_modules/

# Not runtime: tests, docs, API collections, specs, deploy templates, compose files
tests/
docs/
postman/
_specs/
deploy/
docker-compose*.yml
*.md
requirements-dev.txt

# Client data and generated output. Nothing under app/ reads data/ at runtime;
# the CSV loaders in scripts/ are one-shot and run from a workstation.
data/
!data/clean_leather_lots.csv
var/
*.xlsx
*.xls
*.pdf
*.dxf
*.log
celerybeat-schedule*

# Per-module source dumps
app/**/*.txt
alembic/*.txt
*.postman_collection.json
