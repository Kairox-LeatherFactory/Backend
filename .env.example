# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=local
DEBUG=true
# Root log level. DEBUG traces every pipeline step (upload → scan → classify →
# validate → BOM extract); INFO is the production default.
LOG_LEVEL=INFO

# ── Database ─────────────────────────────────────────────────────────────────
# SYNC URL (used by Alembic migrations and scripts/seed.py).
DATABASE_URL=postgresql+psycopg2://factory:factory@localhost:5432/factory
# ASYNC URL (used by the live API). Leave blank to auto-derive from DATABASE_URL
# by swapping the driver to asyncpg.
ASYNC_DATABASE_URL=
# Optional READ-ONLY URL for the LLM/agent path (least-privilege Postgres role,
# SELECT on whitelisted tables only). Blank => unused. NOT Supabase Auth.
AI_READER_DATABASE_URL=

# ── Auth (self-issued JWT) — REQUIRED EVERYWHERE, INCLUDING LOCAL ────────────
# THE APP WILL NOT BOOT until you replace this. There is no dev exemption any
# more (2026-09-23): a placeholder key is forgeable wherever it runs, and a
# token minted on a laptop is the same token. Generate yours with
#
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
#
# Rotating this key invalidates every token already issued — everyone logs in
# again. That is the only cost.
SECRET_KEY=change-me-to-a-long-random-string

# ── CORS ─────────────────────────────────────────────────────────────────────
# The browser origins allowed to call this API. Comma-separated, scheme
# included, NO TRAILING SLASH (a browser sends `Origin: https://host`, so
# "https://host/" matches nothing and every request fails with a CORS error).
#
# Leaving this BLANK is now safe in every environment: config.py falls back to
# the four known frontends below (Hamthan, 2026-09-23) instead of failing
# closed, so a deploy that forgets this variable still serves the real UI. A
# dev box additionally gets localhost:3000 / :8081 / :19006.
CORS_ORIGINS=https://frontend-rust-pi-23.vercel.app,https://stagingpte.vercel.app,http://localhost:3005,http://localhost:3012

# ── Interactive API docs ─────────────────────────────────────────────────────
# /docs and /redoc are ON in every environment, staging and production
# included. They expose the route map, not access — every route still enforces
# its JWT and role gate. Set false only if this API is ever put on the open
# internet.
DOCS_ENABLED=true

# ── Database connection pool — THE concurrency ceiling ───────────────────────
# A request holds one pooled connection for its whole lifetime, so the requests
# this service can serve at once is:
#
#     (gunicorn workers or ECS tasks) x (DB_POOL_SIZE + DB_MAX_OVERFLOW)
#
# Multiply that out against your Postgres max_connections before raising it — or
# put RDS Proxy / PgBouncer in front and size against ITS client limit, which is
# what lets you add tasks past the server's own connection budget.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
# Fail fast under saturation rather than making callers wait SQLAlchemy's 30s.
DB_POOL_TIMEOUT=10
# Stay below any upstream idle-connection reaper (RDS Proxy, PgBouncer, managed PG).
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Login rate limiting ──────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=600

# ── Domain ───────────────────────────────────────────────────────────────────
SEA_CUTOFF_WARNING_DAYS=7

# ── Chat / document extraction (BOM Procurement Workflow) ─────────────────────
# Chat agent model. Blank => deterministic router (no LLM).
CHAT_MODEL=
# Extraction is deterministic-first; an LLM runs ONLY for scanned/handwritten PDFs,
# narrative spec sheets, and genuinely ambiguous classification. Provider chain:
# EXTRACTION_MODEL (Gemini) -> EXTRACTION_FALLBACK_MODEL (Groq) -> manual entry.
EXTRACTION_MODEL=gemini:gemini-2.0-flash
EXTRACTION_FALLBACK_MODEL=groq:llama-3.3-70b-versatile
GEMINI_API_KEY=
GROQ_API_KEY=
# Hard per-call timeout (seconds) for ANY LLM call. A hung/slow Gemini raises after
# this so the Gemini → Groq → deterministic fallback fires instead of blocking forever.
# LLM_MAX_RETRIES=0 stops a dead provider burning the budget on internal backoff.
LLM_REQUEST_TIMEOUT=20
LLM_MAX_RETRIES=0

# Scanned-document escalation ladder for identity validation:
#   heuristic -> OCR (Tesseract) fills the text for the text classifier
#             -> if still below VISION_CONF_THRESHOLD, send the page IMAGES to Gemini vision.
# OCR needs the Tesseract BINARY installed on the host/image (Windows: install
# "Tesseract-OCR" and put it on PATH; Debian: apt-get install tesseract-ocr). Vision
# needs only PyMuPDF + GEMINI_API_KEY. Either rung no-ops gracefully if unavailable.
OCR_ENABLED=true
OCR_LANGUAGE=eng
OCR_MAX_PAGES=5
OCR_DPI=200
VISION_CLASSIFIER_ENABLED=true
VISION_MODEL=gemini:gemini-2.0-flash
VISION_CONF_THRESHOLD=0.5
VISION_MAX_PAGES=4

# ── Stage-1 upload, storage & virus scan (BOM procurement front door) ─────────
# Pluggable storage backend (no hard Supabase dependency; local for dev/tests).
#   local (default) | s3 | minio | supabase
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./var/procurement-documents
# Supabase Storage (PRODUCTION driver) — private bucket, server-side service key.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=procurement-documents
# S3 / MinIO (self-hosted staging) — only if STORAGE_BACKEND=s3/minio.
S3_ENDPOINT_URL=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Upload limits + virus scan. VIRUS_SCAN_ENABLED ON in staging/prod (reject on hit,
# fail closed if clamd is unreachable); set false in dev to skip (scan_status=skipped).
MAX_UPLOAD_MB=25
VIRUS_SCAN_ENABLED=true
CLAMD_HOST=127.0.0.1
CLAMD_PORT=3310

# ── Celery + Redis (the BOM pipeline runs here) ───────────────────────────────
# EVERYTHING in the bom module is a Celery task: build_order_breakdown_for_submission
# (Gemini extraction, 30-200s), parse_pattern_dxf, generate_bom, plus two beat jobs.
# With no worker consuming this broker, POST .../order-breakdown still returns 202
# and nothing is ever extracted — so treat the worker as part of the app, not an extra.
#
# Broker = task queue. Result backend = task results. Separate DBs (/0 and /1) so
# clearing results can never drop queued work. Upstash / Redis Cloud: use rediss://
# and make sure the instance is maxmemory-policy=noeviction (an evicting broker
# silently discards queued jobs that the API already 202'd).
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
# Import paths, resolved by entrypoint.sh. The BEAT app is deliberately different:
# conf.beat_schedule lives in app/core/beat_schedule.py, which app.core.celery does
# not import — point beat at app.core.celery and it runs with an EMPTY schedule.
CELERY_APP=app.core.celery:celery_app
CELERY_BEAT_APP=app.core.beat_schedule:celery_app
# Prefork child processes. Near the core count — the DXF parse is CPU-bound.
CELERY_CONCURRENCY=4
CELERY_LOGLEVEL=info
# Recycle a child after N tasks: ezdxf/shapely hold memory across a big pattern.
CELERY_MAX_TASKS_PER_CHILD=100
# DEV ONLY. true => the worker runs under watchmedo and restarts on any .py save.
# Without this, an edit to a task or a pydantic schema does nothing until you run
# `docker compose restart worker` — the single most common "my fix didn't work".
CELERY_AUTORELOAD=false
# Leave EMPTY unless you also configure task_routes/task_default_queue in
# app/core/celery.py. Tasks publish to the default queue "celery"; a worker
# started with -Q something-else consumes nothing while tasks pile up.
CELERY_QUEUES=
# SIGTERM grace on shutdown. task_time_limit is 300s, so anything less can kill a
# running extraction mid-flight (acks_late then redelivers and you pay it twice).
CELERY_STOP_GRACE=310s
# Flower (docker compose --profile monitor up -d flower). ALWAYS set basic auth if
# it is reachable from anywhere but localhost — Flower can revoke/terminate tasks.
FLOWER_BASIC_AUTH=
FLOWER_HOST_PORT=5555
