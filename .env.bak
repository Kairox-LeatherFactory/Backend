# ── Application ──────────────────────────────────────────────────────────────
ENVIRONMENT=local
DEBUG=true

# ── Database ─────────────────────────────────────────────────────────────────
# Supabase (production pooler). Sync URL uses psycopg2 for Alembic/seed.
# DATABASE_URL=postgresql+psycopg2://postgres.batnwilrquneoyikanie:Hamthan243108%40@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
# # Async URL (asyncpg) for the live API — derived from DATABASE_URL if left blank.
# ASYNC_DATABASE_URL=postgresql+asyncpg://postgres.batnwilrquneoyikanie:Hamthan243108%40@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
# Local SQLite fallback (uncomment to run fully offline):
# DATABASE_URL=sqlite+pysqlite:///./factory.db

DATABASE_URL=postgresql+psycopg2://postgres:1234@localhost:5432/Factory2
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:1234@localhost:5432/Factory2

# ── Auth (self-issued JWT — generate a strong random key for production) ──────
SECRET_KEY=dev-only-insecure-change-me-in-prod
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Login rate limiting ──────────────────────────────────────────────────────
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=600

# ── Domain ───────────────────────────────────────────────────────────────────
SEA_CUTOFF_WARNING_DAYS=7

# ── AI Chatbot (LangGraph agent) ──────────────────────────────────────────────
# Blank => deterministic router (exact answers, no model). Set to a provider spec
# to enable the real LangGraph ReAct agent. Examples:
#   groq:llama-3.3-70b-versatile   (hosted, fast, free tier — needs GROQ_API_KEY)
#   ollama:qwen2.5:3b-instruct     (local, free)
#   anthropic:claude-3-5-haiku     (hosted)
CHAT_MODEL=groq:llama-3.3-70b-versatile
GROQ_API_KEY=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
