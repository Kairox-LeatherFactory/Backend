    {
      "name": "Update Client",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/clients/{{client_id}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "clients",
            "{{client_id}}"
          ],
          "variable": [
            {
              "key": "client_id",
              "value": "00000000-0000-0000-0000-000000000000"
            }
          ]
        },
        "description": "Edit a client. PARTIAL \u2014 only the fields present in the request body are\nwritten, so a form that posts one field cannot blank the rest.\n\nThis is also the DEACTIVATE door: `{\"is_active\": false}` retires a client\nthat has traded, which is what you want instead of DELETE once they have\norders. `code` is unique across clients; a collision is a 409.\n\nDM only, matching client creation.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"\",\n  \"country\": \"\",\n  \"code\": \"\",\n  \"currency\": \"\",\n  \"default_size_system\": \"\",\n  \"brand\": \"\",\n  \"label\": \"\",\n  \"contact_email\": \"\",\n  \"contact_phone\": \"\",\n  \"address\": \"\",\n  \"is_active\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    }
  ]
}