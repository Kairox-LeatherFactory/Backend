{
  "info": {
    "name": "KairoX \u00b7 Client",
    "description": "Buyers, their orders, and the styles under them.\n\nSETUP\n  1. Set `base_url` (default http://127.0.0.1:8000).\n  2. Import `user.postman_collection.json` and run Login.\n  3. Paste `access_token` from that response into this collection's\n     `token` variable. Every request here inherits bearer auth.\n\nOptional query params are present but DISABLED, so each request runs\nas-is. Generated from the app's own OpenAPI schema by\n`python scripts/make_postman_per_service.py` \u2014 re-run it after changing\nroutes rather than editing requests by hand.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Add Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/clients/{{client_id}}/orders",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "clients",
            "{{client_id}}",
            "orders"
          ],
          "variable": [
            {
              "key": "client_id",
              "value": "00000000-0000-0000-0000-000000000000"
            }
          ]
        },
        "description": "Add another order (new unique order_number) to an existing client.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"order_number\": \"\",\n  \"order_date\": \"2026-08-01\",\n  \"delivery_deadline\": \"2026-08-01\",\n  \"sea_cutoff_date\": \"2026-08-01\",\n  \"ship_mode\": \"sea\",\n  \"currency\": \"\",\n  \"agent\": \"\",\n  \"line\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "Client Orders",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/clients/{{client_id}}/orders",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "clients",
            "{{client_id}}",
            "orders"
          ],
          "variable": [
            {
              "key": "client_id",
