              "key": "start",
              "value": "2026-08-01",
              "description": "",
              "disabled": false
            },
            {
              "key": "end",
              "value": "2026-08-01",
              "description": "",
              "disabled": false
            },
            {
              "key": "employee_id",
              "value": "00000000-0000-0000-0000-000000000000",
              "description": "",
              "disabled": true
            },
            {
              "key": "style_code",
              "value": "",
              "description": "",
              "disabled": true
            }
          ]
        },
        "description": "Per-employee rate / piece / earnings analytics. Cost data \u2014 DM, MD, HR only."
      },
      "response": []
    },
    {
      "name": "Explorer",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/v1/analytics/explorer",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "analytics",
            "explorer"
          ],
          "query": [
            {
              "key": "include_pieces",
              "value": "True",
              "description": "",
              "disabled": true
            },
            {
              "key": "pieces_per_style",
              "value": "100",
              "description": "Cap on piece leaves per style. The style's true piece_count is always reported; pieces_truncated says when leaves were cut.",
              "disabled": true
            }
          ]
        },
        "description": "Left-panel nav tree: Client -> Order -> Style -> Piece, scoped to the\nsigned-in user. CLIENT-role users see only their own client.\n\nTHE LEAVES ARE CAPPED. `include_pieces` defaults to True and there was no\nbound, so the ordinary call built a tree of every garment the factory has\never made \u2014 a single live style runs to 1,425 pieces. Each style now carries\nat most `pieces_per_style` leaves, its real `piece_count`, and a\n`pieces_truncated` flag. Pass include_pieces=false for the skeleton alone."
      },
      "response": []
    },
