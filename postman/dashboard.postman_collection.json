          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "dashboard",
            "cutting",
            "consumption"
          ],
          "query": [
            {
              "key": "order_id",
              "value": "00000000-0000-0000-0000-000000000000",
              "description": "",
              "disabled": true
            },
            {
              "key": "employee_id",
              "value": "00000000-0000-0000-0000-000000000000",
              "description": "",
              "disabled": true
            },
            {
              "key": "start",
              "value": "2026-08-01",
              "description": "",
              "disabled": true
            },
            {
              "key": "end",
              "value": "2026-08-01",
              "description": "",
              "disabled": true
            },
            {
              "key": "stage",
              "value": "",
              "description": "LEATHER_CUTTING (default) or LINING_CUTTING. Rows never mix stages: the lot column follows the stage.",
              "disabled": true
            },
            {
              "key": "include_unmeasured",
              "value": "False",
              "description": "Include cut events with no recorded quantity (actual_consumption: null) instead of omitting them.",
              "disabled": true
            }
          ]
        },
        "description": "Cutting \u00a711/\u00a714: one row per leather-cut event with actual consumption.\n\nONE STAGE PER RESPONSE. This previously returned BOTH cut stages while joining\nthe leather lot, so lining-cut events appeared here with a blank lot and their\nquantities counted toward leather totals."
      },
      "response": []
    },
