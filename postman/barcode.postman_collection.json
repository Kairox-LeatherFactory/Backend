            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{base_url}}/api/v1/barcode/print",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "api",
            "v1",
            "barcode",
            "print"
          ]
        },
        "description": "Code128-ready payload for one or many codes (or all pieces of a SKU/order).",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"codes\": [\n    \"\"\n  ],\n  \"sku_id\": \"00000000-0000-0000-0000-000000000000\",\n  \"order_id\": \"00000000-0000-0000-0000-000000000000\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
