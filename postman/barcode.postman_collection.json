            "{{order_id}}",
            "analytics"
          ],
          "variable": [
            {
              "key": "order_id",
              "value": "00000000-0000-0000-0000-000000000000"
            }
          ]
        },
        "description": "Per-order: planned vs generated vs balance (order total AND per style).\nIncludes duplicates=0 integrity proof and a half_minted flag."
      },
      "response": []
    },
