            "barcodes"
          ],
          "query": [
            {
              "key": "sku_id",
              "value": "00000000-0000-0000-0000-000000000000",
              "description": "Filter to one SKU.",
              "disabled": true
            },
            {
              "key": "style_id",
              "value": "00000000-0000-0000-0000-000000000000",
              "description": "Filter to one style.",
              "disabled": true
            },
            {
              "key": "size",
              "value": "",
              "description": "Filter to one size (style+size).",
              "disabled": true
            },
            {
              "key": "status",
              "value": "",
              "description": "",
              "disabled": true
            },
            {
              "key": "date_from",
              "value": "2026-08-01T09:00:00Z",
              "description": "Generated at/after.",
              "disabled": true
            },
            {
              "key": "date_to",
              "value": "2026-08-01T09:00:00Z",
              "description": "Generated at/before.",
              "disabled": true
            },
            {
              "key": "page",
              "value": "1",
              "description": "",
              "disabled": true
            },
            {
              "key": "page_size",
              "value": "50",
              "description": "",
              "disabled": true
            }
          ],
          "variable": [
            {
              "key": "order_id",
              "value": "00000000-0000-0000-0000-000000000000"
            }
          ]
        },
        "description": "The history table: order \u2192 style \u2192 piece, filterable by SKU, style, or\nstyle+size, plus status and generated-date range. Paginated (JP ~= 1,273)."
      },
      "response": []
    },
    {
      "name": "Print Labels",
